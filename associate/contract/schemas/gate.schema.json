{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentculture/associate/contract/gate.schema.json",
  "title": "associate safety gate",
  "description": "The pre-mutation safety-gate question set (gate.json). Structural shape only; cross-field rules (thresholds in [0,1], every rule names an existing question and option) live in validate.validate_gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decider", "state_fields", "effects", "isolation", "change", "questions", "clef", "super", "large_state", "readonly_fallback", "redaction"],
  "properties": {
    "$comment": {"type": "string"},
    "version": {"type": "integer"},
    "decider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "header", "domain", "max_input_tokens"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "header": {"type": "string"},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "max_input_tokens": {"type": "integer"}
      }
    },
    "state_fields": {"type": "array", "items": {"enum": ["task", "action", "effect", "arguments", "model", "isolation", "change"]}},
    "effects": {
      "type": "object",
      "description": "Tool name -> what the tool does (d10). Must name exactly models.json mutating_tools + gated_tools; checked in validate.validate_gate.",
      "properties": {"$comment": {"type": "string"}},
      "additionalProperties": {"type": "string", "pattern": "\\S"}
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies_to", "describe"],
      "properties": {
        "$comment": {"type": "string"},
        "applies_to": {"type": "array", "items": {"type": "string"}},
        "describe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worktree", "in-place"],
          "properties": {
            "worktree": {"type": "string", "pattern": "\\S"},
            "in-place": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    },
    "change": {
      "type": "object",
      "description": "d20: the change line (lines a write adds and removes). Cross-field rules (applies_to tools have effects, positive bounds) live in validate.validate_gate.",
      "additionalProperties": false,
      "required": ["applies_to", "max_file_bytes", "max_render_bytes"],
      "properties": {
        "$comment": {"type": "string"},
        "applies_to": {"type": "array", "items": {"type": "string"}},
        "max_file_bytes": {"type": "integer"},
        "max_render_bytes": {"type": "integer"}
      }
    },
    "questions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/question"}},
    "clef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_when"],
      "properties": {
        "$comment": {"type": "string"},
        "allow_when": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "super": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "answer_shape", "allow_when"],
      "properties": {
        "$comment": {"type": "string"},
        "model": {"type": "string", "description": "models.json registry key of the Super-tier model."},
        "answer_shape": {"type": "object"},
        "allow_when": {"type": "object"}
      }
    },
    "large_state": {
      "type": "object",
      "description": "d16/d19: who judges a state over decider.max_input_tokens; d20: within its own timeout. Cross-field rules (registry keys, distinct, a budget above the decider's, a positive timeout) live in validate.validate_gate.",
      "additionalProperties": false,
      "required": ["evaluators", "max_input_tokens", "self_fallback", "timeout_ms"],
      "properties": {
        "$comment": {"type": "string"},
        "evaluators": {"type": "array", "items": {"type": "string"}},
        "max_input_tokens": {"type": "integer"},
        "self_fallback": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "description": "d20: how long the large-state evaluator may take before it counts as unreachable."}
      }
    },
    "readonly_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "allow"],
      "properties": {
        "$comment": {"type": "string"},
        "when": {"enum": ["decider_and_super_unreachable"]},
        "allow": {"enum": ["readonly_only"]}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "keys"],
      "properties": {
        "$comment": {"type": "string"},
        "policy_ref": {"type": "string"},
        "keys": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions"],
      "properties": {
        "type": {"enum": ["noul", "choice"]},
        "instructions": {"type": "string"},
        "criteria": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "op", "value"],
      "properties": {
        "question": {"type": "string"},
        "option": {"type": "string"},
        "op": {"enum": [">=", "<="]},
        "value": {"type": "number"}
      }
    }
  }
}
